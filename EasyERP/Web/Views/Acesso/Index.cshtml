@model LoginRequestDTO

<div class="row justify-content-center align-items-center min-vh-100">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4 p-sm-5">

                <!-- Cabeçalho do Card -->
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-primary">Entrar na Conta</h3>
                    <p class="text-muted small">Insira suas credenciais para continuar</p>
                </div>

                <!-- Formulário -->
                <form data-ajax="true" method="post" id="form-login" asp-action="Login" asp-controller="Acesso">

                    <!-- Campo Login -->
                    <div class="form-floating mb-3">
                        <input asp-for="Login" class="form-control" id="floatingLogin" placeholder="Seu login ou e-mail" />
                        <label asp-for="Login" for="floatingLogin">Login</label>
                        <span asp-validation-for="Login" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Campo Senha -->
                    <div class="form-floating mb-4">
                        <input asp-for="Senha" type="password" class="form-control" id="floatingSenha" placeholder="Sua senha" />
                        <label asp-for="Senha" for="floatingSenha">Senha</label>
                        <span asp-validation-for="Senha" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Botão de Submit -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                            Entrar
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>