@using Web.Views.Shared.Components.CardMenuComponent
@{
    ViewData["Title"] = "Home Page";
    var modulos = this.User.ObterModulosDoUsuario();
}

<div class="text-center">
    <div class="row justify-content-center gap-3">
        @foreach (var m in modulos)
        {
            @await Component.InvokeAsync("CardMenuComponent", new CardMenu
                {
                    Texto = m.Nome,
                    Url = m.BaseUrl,
                    Imagem = m.Imagem,
                    Estilo = new Estilo()
                })
        }
    </div>
</div>
