@using Web.Views.Shared.Components.TopoMenus
@{
    ViewData["Title"] = "Módulos";
}

@await Component.InvokeAsync(nameof(TopoMenuComponent), new TopoMenu
{
    Titulo = "Módulos",
    FormActionURL = Url.Action("Listar", "Modulo"),
    Botoes = new List<BotaoComponent>
            {
                new BotaoComponent (texto: "Cadastrar", estilo: new BotaoStyle (classe: "btn btn-sm btn-success", submit: false), url: Url.Action("Cadastro", "Modulo")),
                new BotaoComponent (texto: "Pesquisar", estilo: new BotaoStyle (classe: "btn btn-sm btn-primary", submit: true), url: null),
                new BotaoComponent (url: Url.Action("Index", "Modulo"), null)
            }
})

<hr />

<div id="resultado">
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#pesquisa-base').submit();
        });
    </script>
}