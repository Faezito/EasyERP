@model Navbar
@{
    var titulo = Model.Titulo;
    var usuario = this.User.ObterUsuario();
}

<nav class="navbar at-bg-teal navbar-dark bg-secondary navbar-expand-sm navbar-toggleable-sm shadow text-light box-shadow mb-5">
    <div class="container-fluid">
        <div class="d-flex gap-2">
            @if (!string.IsNullOrWhiteSpace(Model.Logo))
            {
                <img src="/img/icon.png" style="width: 40px; height: 35px;" />
            }
            <a class="navbar-brand text-light" asp-area="" asp-controller="Menu" asp-action="Index">
                @Model.Titulo
            </a>
        </div>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex text-light justify-content-between" data-bs-theme="dark">
            <ul class="navbar-nav flex-grow-1">
                @foreach (var link in Model.Links)
                {
                    <li class="nav-item px-2">
                        <a class="@link.Estilo.Classe" href="@link.Url">@link.Texto</a>
                    </li>
                }
            </ul>
            <div class="nav-item col-3 text-end me-3">
                @if (usuario?.PublicId == null)
                {
                    <a class="ms-3 text-light" asp-area="" asp-controller="Usuario" asp-action="Cadastro">Cadastre-se</a>
                    <a class="ms-3 text-light" asp-area="" asp-controller="Home" asp-action="Login">Login</a>
                }
                else
                {
                    @if (usuario != null)
                    {
                        <div class="dropdown">
                            <button class="btn dropdown-toggle text-light" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @usuario?.PessoaFisica?.NomeCompleto.Split(" ")[0]
                            </button>
                            <ul class="dropdown-menu dropdown-menu-center dropdown-menu-md-end bg-dark dropdown-menu-dark">
                                <a class="dropdown-item"
                                   role="button"
                                   asp-controller="Usuario"
                                   asp-action="Editar"
                                   asp-route-pessoaId="@this.User.GetUserId()">
                                    <li>
                                        Perfil
                                    </li>
                                </a>

                                @if (usuario?.Perfil == Perfil.Administrador)
                                {
                                    <a class="dropdown-item" role="button" asp-controller="Menu" asp-action="Configuracoes">
                                        <li>
                                            Painel Administrativo
                                        </li>
                                    </a>

                                    <a class="dropdown-item" role="button" asp-controller="LogDeErro" asp-action="Index">
                                        <li>
                                            Logs de Erro do Sistema
                                        </li>
                                    </a>
                                }
                                <form asp-controller="Acesso" asp-action="Logout" asp-area="" method="post">
                                    <button type="submit" class="w-100 text-start btn p-0 ps-3">Sair</button>
                                </form>
                            </ul>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</nav>