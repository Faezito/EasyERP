@using Web.Views.Shared.Components.CardMenuComponent
@model CardMenu

<div class="col-6 col-md-4 col-lg-3 col-xl-2">
    <a href="@Model.Url">
        <div class="card card-menu @Model.Estilo.Classe shadow py-3" style="min-width: 11rem; height: 10rem">
            <div class="card-body text-center">
                <h1 class="text-success-emphasis">
                    <i class="@Model.Imagem"></i>
                </h1>
                <h6 class="card-title menu-item-title text-uppercase mt-auto text-secondary">
                    @Html.Raw(Model.Texto)
                </h6>
            </div>
        </div>
    </a>
</div>

@*
    @await Component.InvokeAsync("CardMenuComponent", new CardMenu { })
*@