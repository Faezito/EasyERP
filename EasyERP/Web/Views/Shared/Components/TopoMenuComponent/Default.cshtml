@using Web.Views.Shared.Components.TopoMenus
@model TopoMenu

<div class="row justify-content-between">
    <div class="col-12 col-md-6 text-center text-md-start mt-auto">
        <h4 class="text-secondary fs-3 d-block d-md-none text-uppercase w-auto">
            @Html.Raw(Model.Titulo)
        </h4>

        <h4 class="text-secondary fs-4 d-md-block d-none  text-uppercase w-auto">
            @Html.Raw(Model.Titulo)
        </h4>
    </div>
    <div class="col-12 col-md-6 col-lg-3 d-flex gap-2 justify-content-end mt-auto">
        <form id="pesquisa-base" action="@Model.FormActionURL" method="post" data-ajax="true">
            @foreach (var input in Model.Campos)
            {
                <input name="@input.Name" id="@input.Id" class="col-@input.Estilo?.Col w-@input.Estilo?.Width" />
            }

            @if (Model.DropMeses != null)
            {
                <select name="Mes" class="form-select col-auto">
                    @await Component.InvokeAsync("DropMesesComponent", Model.DropMeses)
                </select>
            }

            @if (Model.DropAnos != null)
            {
                <select name="Ano" class="form-select col-auto">
                    @await Component.InvokeAsync("DropAnosComponent", Model.DropAnos)
                </select>
            }

            @foreach (var btn in Model.Botoes)
            {
                if (string.IsNullOrWhiteSpace(btn.Url))
                {
                    <button class="@btn.Estilo?.Classe"
                            id="@btn.Id"
                            type="@(btn.Estilo!.Submit ? "submit" : "button")"
                            onclick="@btn.OnClick?.Trim()">
                        @Html.Raw(btn.Texto)
                    </button>
                }
                else
                {
                    <a href="@btn.Url" class="@btn.Estilo?.Classe" id="@btn.Id">
                        @Html.Raw(btn.Texto)
                    </a>
                }
            }
        </form>
    </div>
</div>