@using Model.DTOs.Escolar.Turma
@using Web.Views.Shared.Components.TopoMenus
@model TurmaDTO

@await Component.InvokeAsync(nameof(TopoMenuComponent), new TopoMenu
{
    Titulo = "Cadastrar Turma",
    Botoes = new List<BotaoComponent>
            {
                new BotaoComponent (url: null, onclick: "history.back(); return false;")
            }
})

<hr />

<form method="post" id="formCadastroTurma"
      action="@Url.Action("Cadastrar", "Turma")" data-ajax="true" class="row g-3 needs-validation">

    <div class="col-md-6">
        <label class="form-label" asp-for="Descricao">Descrição</label>
        <input class="form-control" asp-for="Descricao" required />
        <span class="invalid-feedback" asp-validation-for="Descricao"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label" asp-for="Sala">Sala</label>
        <input class="form-control" asp-for="Sala" required />
        <span class="invalid-feedback" asp-validation-for="Sala"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label" asp-for="Predio">Prédio</label>
        <input class="form-control" asp-for="Predio" />
        <span class="invalid-feedback" asp-validation-for="Predio"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label" asp-for="ResponsavelId">Id do Responsável</label>
        <input class="form-control" asp-for="ResponsavelId" type="number" />
        <span class="invalid-feedback" asp-validation-for="ResponsavelId"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label" asp-for="ViceResponsavelId">Id do Vice-Responsável</label>
        <input class="form-control" asp-for="ViceResponsavelId" type="number" />
        <span class="invalid-feedback" asp-validation-for="ViceResponsavelId"></span>
    </div>

    <div class="d-flex justify-content-start">
        <button type="submit" id="btnSalvar" class="btn btn-success w-auto">Salvar</button>
    </div>
</form>

@section Scripts {
    <script>
    </script>
}
