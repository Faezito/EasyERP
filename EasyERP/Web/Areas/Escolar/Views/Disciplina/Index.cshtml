@using Web.Views.Shared.Components.TopoMenus
@{
    ViewData["Title"] = "Disciplinas";
}

@await Component.InvokeAsync(nameof(TopoMenuComponent), new TopoMenu
{
    Titulo = "Disciplinas",
    FormActionURL = Url.Action("Listar", "Disciplina", new { area = "Escolar" }),
    Botoes = new List<BotaoComponent>
    {
        new BotaoComponent(texto: "Cadastrar", estilo: new BotaoStyle(classe: "btn btn-sm btn-success", submit: false), url: Url.Action("Cadastro", "Disciplina", new { area = "Escolar" })),
        new BotaoComponent(texto: "Pesquisar", estilo: new BotaoStyle(classe: "btn btn-sm btn-primary", submit: true), url: null),
        new BotaoComponent(url: Url.Action("Index", "Home", new { area = "Escolar" }), null)
    }
})

<hr />

<div id="resultado">
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#pesquisa-base').submit();
        });
    </script>
}
