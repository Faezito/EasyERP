@model Model.DTOs.Escolar.Disciplina.DisciplinaCadastroDTO

<form method="post" id="formCadastroDisciplina" action="@Url.Action("Cadastrar", "Disciplina", new { area = "Escolar" })" data-ajax="true" class="row g-3 needs-validation">
    <div class="col-md-6">
        <label class="form-label" asp-for="Nome">Nome</label>
        <input class="form-control" asp-for="Nome" required />
        <span class="invalid-feedback" asp-validation-for="Nome"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label" asp-for="Descricao">Descrição</label>
        <input class="form-control" asp-for="Descricao" required />
        <span class="invalid-feedback" asp-validation-for="Descricao"></span>
    </div>

    <div class="col-md-6 d-flex align-items-center mt-4">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" asp-for="Ativa" />
            <label class="form-check-label" asp-for="Ativa">Ativa</label>
        </div>
    </div>

    <div class="col-12">
        <button type="submit" id="btnSalvar" class="btn btn-success w-100">Salvar</button>
    </div>
</form>

@section Scripts {
    <script>
    </script>
}
