@using Web.Views.Shared.Components.TopoMenus
@{
    ViewData["Title"] = "Alunos";
}

@await Component.InvokeAsync(nameof(TopoMenuComponent), new TopoMenu
{
    Titulo = "Alunos",
    FormActionURL = Url.Action("Listar", "Aluno"),
    Botoes = new List<BotaoComponent>
            {
                new BotaoComponent (
                    texto: "Cadastrar",
                    estilo: new BotaoStyle (classe: "btn btn-sm btn-success", submit: false),
                    url: Url.Action("Cadastro", "Aluno")
                ),
                new BotaoComponent (
                    texto: "Pesquisar", 
                    estilo: new BotaoStyle (classe: "btn btn-sm btn-primary", submit: true), 
                    url: null
                ),
                new BotaoComponent (url: Url.Action("Index", "Home"), null)
            }
})

<hr />

<div id="resultado">
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#pesquisa-base').submit();
        });
    </script>
}