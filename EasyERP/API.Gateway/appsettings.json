{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "ChaveSuperSecretaDeSegurancaJWTDoEasyERP",
    "Issuer": "ERP.Api",
    "Audience": "ERP.Client",
    "ExpirationHours": 8
  },

  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },

      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },

      "escolar-route": {
        "ClusterId": "escolar-cluster",
        "Match": {
          "Path": "/api/escolar/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "https://localhost:44348/"
          }
        }
      },

      "admin-cluster": {
        "Destinations": {
          "admin-api": {
            "Address": "https://localhost:44379/"
          }
        }
      },

      "escolar-cluster": {
        "Destinations": {
          "escolar-api": {
            "Address": "https://localhost:44339/"
          }
        }
      }
    }
  }
}